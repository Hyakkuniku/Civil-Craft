  clientName: Reed
  jobDescription: Connect the factory to Central Canyonville. Build a safe crossing
    for the test pickup and observe how the structure responds to bending under its
    weight.
  budget: 100000
  liveLoadWeight: 5000
  bridgeSpan: 60
  allowedMaterials: []
  hiddenTools: 
  hiddenMaterials:
  - {fileID: 11400000, guid: 4524a3fc876c6b640a735e6808fe1271, type: 2}
  - {fileID: 11400000, guid: 57a46c6632dd61b4094902963cf1c5be, type: 2}
  - {fileID: 11400000, guid: 9377a255283b8cc499761c693baf53dd, type: 2}

  featureUnlockRewards: []
  clientName: Vance
  jobDescription: We need a bridge across this ravine!
  budget: 100000
  liveLoadWeight: 50
  bridgeSpan: 30
  allowedMaterials: []
  hiddenTools: 
  hiddenMaterials: []
  enforceMaxStress: 0

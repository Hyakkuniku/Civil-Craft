%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f37df8d20f74e62a3e88f7fa41df9b0, type: 3}
  m_Name: Beam Bridge Lesson
  m_EditorClassIdentifier: 
  panelTitle: BEAM BRIDGE SIMULATION
  minimumMessageDuration: 3.5
  fadeDuration: 0.2
  slideDistance: 24
  enableSlowMotion: 1
  simulationTimeScale: 0.5
  vehicleEnteredProgress: 0.1
  vehicleMidpointProgress: 0.5
  vehicleNearEndProgress: 0.85
  highStressThreshold: 0.7
  vehicleStuckDelay: 5
  simulationStarted: Simulation started. A 200 kg vehicle is approaching the bridge.
    Watch how your Beam Bridge responds as the vehicle begins crossing.
  liveLoadStarted:
  vehicleEnteredBridge: The vehicle is moving across the bridge. Observe how the roadway
    and supports carry its weight.
  vehicleReachedMidpoint: The vehicle is approaching the middle of the bridge.
    Watch how the beam responds to the load as it moves across.
  vehicleApproachingEnd: The vehicle is approaching the end of the bridge. Continue
    observing the roadway and supports until it completes the crossing.
  highStressDetected: Orange or red members are carrying a high percentage of their
    capacity. On a beam bridge, a long unsupported span increases bending demand.
  stressLimitExceeded: "BRIDGE TEST FAILED! Your bridge could not safely carry the vehicle
    across the entire crossing. Check that the roadway is connected and supported.
    Review the Wood Pier placement and the sections with the greatest stress.
    Choose Retry to return to Build Mode."
  firstMemberBreak: "BRIDGE TEST FAILED! A structural member failed. Check that the
    roadway is connected and supported. Review the Wood Pier placement and the
    sections with the greatest stress. Choose Retry to return to Build Mode."
  vehicleStuck: The vehicle has stopped moving. Excessive beam deflection or a misaligned
    road joint may be blocking the crossing.
  vehicleFailed: "BRIDGE TEST FAILED! Your bridge could not safely carry the vehicle
    across the entire crossing. Check that the roadway is connected and supported.
    Review the Wood Pier placement and the sections with the greatest stress.
    Choose Retry to return to Build Mode."
  bridgeSucceeded: "BRIDGE SUCCESSFULLY TESTED! Your Beam Bridge successfully carried
    the 200 kg vehicle across the canyon. Your first bridge has passed the simulation.
    Choose Retry to modify it, or Save to record the completed Training Beam Bridge
    in your Almanac."
  simulationStopped: Simulation stopped. Review the beam's deflection and stressed
    areas before revising the design.

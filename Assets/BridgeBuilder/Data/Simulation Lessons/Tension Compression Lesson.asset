%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f37df8d20f74e62a3e88f7fa41df9b0, type: 3}
  m_Name: Tension Compression Lesson
  m_EditorClassIdentifier:
  panelTitle: TENSION & COMPRESSION
  minimumMessageDuration: 3.5
  fadeDuration: 0.2
  slideDistance: 24
  enableSlowMotion: 1
  simulationTimeScale: 0.5
  vehicleEnteredProgress: 0.1
  vehicleMidpointProgress: 0.5
  vehicleNearEndProgress: 0.85
  highStressThreshold: 0.7
  vehicleStuckDelay: 5
  simulationStarted: Simulation started. The truck and its loaded cargo form the moving live load. Watch the structure as it crosses.
  liveLoadStarted: The loaded truck is transferring weight onto the roadway. Connected structural members carry that load toward the supports.
  vehicleEnteredBridge: Some members may be pulled in tension while others are pushed in compression. The forces depend on the design and load position.
  vehicleReachedMidpoint: The loaded truck is near midspan. Observe how the structural members share the load as its position changes.
  vehicleApproachingEnd:
  highStressDetected: Orange or red members are using a large share of their capacity. Stress color shows demand, not whether a member is in tension or compression.
  stressLimitExceeded: The bridge exceeded the contract's allowed stress. Review the load path and strengthen the members or supports that need it before testing again.
  firstMemberBreak: A structural member exceeded its capacity and failed. Observe how the remaining members carry the redistributed load.
  vehicleStuck: The loaded truck has stopped moving. Check the roadway alignment and clearance around this area.
  vehicleFailed: The loaded truck could not complete a safe crossing. Review the failed area and improve the load path before testing again.
  bridgeSucceeded: The required loaded truck completed the crossing. The connected members carried the vehicle-and-cargo load safely to the other side.
  simulationStopped: Simulation stopped. Return to editing when you are ready to adjust the design.

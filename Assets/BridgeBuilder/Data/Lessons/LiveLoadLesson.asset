  m_Script: {fileID: 11500000, guid: a4da58d2dc2409c459ef20449bf92a90, type: 3}
  m_Name: LiveLoadLesson
  m_EditorClassIdentifier: 
  lessonId: LESSON001
  lessonTitle: Live Load
  lessonImage: {fileID: 21300000, guid: 2db204386ad37a845b49016eb72888b4, type: 3}
  popupDescription: "The weight of a vehicle, person, or other object that moves or changes position on a structure is called a <b><#E09500>Live Load</color></b>.\n\nThis lesson has been added to your <b><#E09500>Almanac</color></b>."
  almanacImage: {fileID: 0}
  lessonDescription: "A live load is a <b><#E09500>temporary or variable force</color></b>
    imposed on a structure by occupants, vehicles, equipment, materials, or other
    objects that are not permanently part of the structure. On a bridge, live loads
    may <b><#E09500>change in magnitude and position</color></b> as vehicles or pedestrians
    move across the deck, causing different structural members to experience changing
    forces. FHWA guidance, for example, distinguishes temporary construction live
    loads such as workers, tools, supplies, materials, and equipment from permanent
    structural loads. \r\n"

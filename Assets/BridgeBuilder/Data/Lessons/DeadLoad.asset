  m_Name: DeadLoad
  m_EditorClassIdentifier: 
  lessonId: deadload
  lessonTitle: Dead Load
  lessonImage: {fileID: 21300000, guid: 8097286e569a66a4d9e5bfc046b02263, type: 3}
  popupDescription: A dead load is the <b><#E09500>permanent weight of a structure
    and the fixed components</color></b> that it must continuously support.
  almanacImage: {fileID: 0}
  lessonDescription: A dead load is the load associated with the <b><#E09500>permanent
    components of a structure</color></b>. For a bridge, this includes the self-weight
    of structural components such as the <b><#E09500>deck, beams, trusses, piers,
    barriers, and other permanently attached elements</color></b>. Unlike live loads,
    these loads generally <b><#E09500>remain in place and continuously act on
    the structure</color></b> throughout its service life.

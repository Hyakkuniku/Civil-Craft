  m_Name: SteelBeam
  m_EditorClassIdentifier:
  materialId: SteelBeam
  displayName: Steel Beam
  introductionDescription: A rigid steel member for longer spans and heavier loads.
    Use it in trusses and braces that need to carry both tension and compression.
  introductionImage: {fileID: 0}
  almanacDescription: Steel beams resist pulling forces in tension and pushing forces
    in compression. Connect them in triangles so forces can travel from the road deck
    through the truss to the supports. Steel Beam costs more per metre than Concrete
    Beam but adds less weight to the bridge. Each placement adds a matching pair of
    side beams.
  almanacImage: {fileID: 0}
  costPerMeter: 900
  massPerMeter: 60
  maxLength: 20
  maxTension: 1200000
  maxCompression: 2600000
  useSpring: 0
  spring: 5000
  damper: 50
  isRope: 0
  isRoad: 0
  isPier: 0

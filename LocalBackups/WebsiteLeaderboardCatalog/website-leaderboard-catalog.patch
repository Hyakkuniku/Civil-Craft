+test("all 18 playable and side boards use permanent-ID hashes and the updated story labels", () => {
+  assert.equal(LEADERBOARD_CONTRACTS.length, 18);
+  assert.equal(new Set(LEADERBOARD_CONTRACTS).size, 18);
